# 本地 RAG 知识库问答系统

# 环境变量配置文件
# 复制此文件为 .env 并修改相应配置

# ============ Ollama 配置 ============
# Ollama 服务地址
OLLAMA_HOST=http://localhost:11434

# 向量模型 - Qwen3-Embedding 用于文本向量化
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-f16:latest

# 问答模型 - Gemma3:1b 用于生成回答
LLM_MODEL=gemma3:1b

# ============ Milvus 配置 ============
# Milvus 连接地址
MILVUS_URI=http://localhost:19530

# 可选：使用 Docker 部署时的配置
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# 集合名称
COLLECTION_NAME=knowledge_base

# ============ 应用配置 ============
# Flask 密钥
SECRET_KEY=local-rag-secret-key-2026

# Flask 调试模式 (生产环境设为 False)
DEBUG=True
